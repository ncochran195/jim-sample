{
  "extends": "./tsconfig.json",
  "compilerOptions": { "rootDir": "src", "outDir": "dist" },
  "include": ["src"],
  // JIM's Steps and regression tests live beside each module; they are test
  // code, built and run by Playwright, never shipped in the app.
  "exclude": ["src/**/steps/**", "src/**/regression/**"]
}
